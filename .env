# =====================================================================
# Configuração central do sistema (lida pelo docker compose).
# Nenhum valor é hard-coded no código: tudo vem daqui via variáveis de
# ambiente injetadas no docker-compose.yml.
# =====================================================================

# ---------- Kafka ----------
KAFKA_IMAGE=apache/kafka:3.9.1
# Mesmo ID para os 3 nós: identifica o cluster KRaft (gerado com kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092

# ---------- Tópico ----------
TOPIC_NAME=dados-sensores
TOPIC_PARTITIONS=6
TOPIC_REPLICATION_FACTOR=3
# Com RF=3 e min.insync=2 o cluster aceita escrita (acks=all) mesmo com 1 broker fora
TOPIC_MIN_INSYNC_REPLICAS=2
ALERT_TOPIC_NAME=alertas

# ---------- Sensores (produtores) ----------
SENSOR_REPLICAS=3
SENSOR_INTERVAL_SECONDS=1.0
# Probabilidade (0..1) de o sensor gerar uma leitura anômala
SENSOR_ANOMALY_PROBABILITY=0.05
SENSOR_SECTORS=linha-producao,refrigeracao,empacotamento
# Máquinas monitoradas por container de sensor (cada máquina = uma chave Kafka)
MACHINES_PER_SENSOR=8
SENSOR_STATS_EVERY_SECONDS=10
# Tempo (ms) que o produtor espera para agrupar mensagens num mesmo envio
PRODUCER_LINGER_MS=5
# Tempo máximo (ms) tentando entregar uma mensagem antes de desistir (cobre quedas de broker)
PRODUCER_DELIVERY_TIMEOUT_MS=120000

# ---------- Processadores (consumidores) ----------
CONSUMER_REPLICAS=3
CONSUMER_GROUP_ID=processadores-sensores
# range | roundrobin | cooperative-sticky
PARTITION_ASSIGNMENT_STRATEGY=range
# Tempo sem heartbeat até o coordenador expulsar o consumidor do grupo
SESSION_TIMEOUT_MS=10000
HEARTBEAT_INTERVAL_MS=3000
# Atraso artificial por mensagem (ms): simula processamento pesado p/ demonstrar carga/lag
PROCESSING_DELAY_MS=0
CONSUMER_BATCH_SIZE=100
CONSUMER_STATS_EVERY_SECONDS=10
# De onde um grupo novo começa a ler quando não há offset salvo: earliest | latest
CONSUMER_AUTO_OFFSET_RESET=earliest

# ---------- Limites para detecção de anomalias ----------
LIMIT_TEMPERATURE_C=85.0
LIMIT_VIBRATION_MM_S=7.1
LIMIT_POWER_KW=45.0

# ---------- PostgreSQL ----------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fabrica
POSTGRES_USER=fabrica
POSTGRES_PASSWORD=fabrica123

# ---------- Kafka UI ----------
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_PORT=8080

# ---------- Scripts de demonstração ----------
# Containers dos brokers (separados por vírgula)
KAFKA_BROKER_CONTAINERS=kafka1,kafka2,kafka3
# Broker derrubado por padrão em "make falha-broker"
DEMO_BROKER=kafka2
# Brokers derrubados por padrão em "make falha-dois-brokers"
DEMO_BROKERS_DUPLA=kafka1,kafka2
# Pausa (s) entre as etapas das demonstrações (pode sobrescrever: ESPERA=10 make ...)
DEMO_ESPERA_SECONDS=20
# Demo de elasticidade: nº de sensores na carga alta e atraso por mensagem (ms)
DEMO_SENSORES=6
DEMO_PROCESSING_DELAY_MS=40

# ---------- Logging ----------
LOG_LEVEL=INFO

# Fuso horário dos containers (para os horários dos logs baterem com os scripts)
TZ=America/Sao_Paulo
